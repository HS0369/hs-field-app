<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Dashboard</title>

<style>
body{font-family:Arial;margin:0;background:#f5f5f5;}
.header{background:#1976d2;color:#fff;padding:15px;text-align:center;font-size:20px;}
.box{background:#fff;margin:10px;padding:15px;border-radius:10px;text-align:center;}
.card{background:#fff;margin:10px;padding:10px;border-radius:8px;}
button{padding:10px;width:90%;margin:10px;border:none;background:#1976d2;color:#fff;border-radius:8px;}
</style>
</head>

<body>

<div class="header">📊 Admin Dashboard</div>

<div class="box">Total Patients: <b id="totalPatients">0</b></div>
<div class="box">Collected: <b id="collectedCount">0</b></div>
<div class="box">Pending: <b id="pendingCount">0</b></div>
<div class="box">Total Collection: ₹<b id="totalAmount">0</b></div>

<button onclick="loadData()">🔄 Refresh</button>

<div id="list"></div>

<script>

const API="https://script.google.com/macros/s/AKfycbzDHuowRFqr63Pxnm4Lk_DWjT3oUZIDBqAAYnyGf1qu_UqF8RILKn1qYmXAWIVm7jvH/exec";

function loadData(){

fetch(API)
.then(r=>r.json())
.then(data=>{

let total=0;
let collected=0;
let pending=0;
let amount=0;

let html="";

data.forEach(obj=>{

let r=obj.data;

total++;

if(r[10]=="Collected"){
collected++;
amount += Number(r[8]||0);
}else{
pending++;
}

html+=`
<div class="card">
<b>${r[3]}</b><br>
📱 ${r[4]}<br>
🧪 ${r[7]}<br>
₹${r[8]}<br>
👨‍⚕️ ${r[9]}<br>
📌 ${r[10]}
</div>`;
});

document.getElementById("totalPatients").innerText=total;
document.getElementById("collectedCount").innerText=collected;
document.getElementById("pendingCount").innerText=pending;
document.getElementById("totalAmount").innerText=amount;

document.getElementById("list").innerHTML=html;

});
}

// auto load
loadData();

</script>

</body>
</html>
